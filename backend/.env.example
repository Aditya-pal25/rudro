# ─── Rudroham Backend Environment Template ─────────────────────────────────
# Copy this file or configure these environment variables directly on Render.

PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/rudroham?retryWrites=true&w=majority

# JWT Authentication
# Generate 64 random bytes: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_64_character_random_hex_secret_here
JWT_EXPIRE=7d

# CORS Allowed Origins (Comma-separated for Vercel storefront + admin)
CLIENT_URLS=https://your-store.vercel.app,http://localhost:5173
ADMIN_CLIENT_URLS=https://your-admin.vercel.app,http://localhost:5174

# Razorpay Keys (Get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Cloudinary Storage for Image Uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Service for OTP / Password Reset
# OPTION A (RECOMMENDED FOR RENDER FREE TIER - Uses HTTPS Port 443, never blocked):
# Resend (https://resend.com - 3000 free emails/mo):
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="RUDROHAM <onboarding@resend.dev>"

# Brevo (https://brevo.com - 300 free emails/day):
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# OPTION B (SMTP / Gmail App Password - NOTE: Render Free Tier blocks SMTP ports 25, 465, 587):
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Initial Admin Seeder Credentials
ADMIN_EMAIL=admin@rudroham.com
ADMIN_PASSWORD=ChangeThisStrongAdminPassword123!
